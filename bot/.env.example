BOT_TOKEN=123456:replace_me
ADMIN_IDS=123456789

# Bothost выдаёт домен вида https://name.bothost.tech — его же указываем здесь
BASE_URL=https://gekgekau.bothost.tech
WEBAPP_URL=https://gekgekau.bothost.tech

# HTTP (Bothost сам прокинет PORT и SSL)
HOST=0.0.0.0
PORT=8080

# На Bothost: HTTP = корневой app.py (Uvicorn), бот = bot/main.py (polling)
# USE_WEBHOOK=0 — правильный режим для Bothost
USE_WEBHOOK=0
WEBHOOK_PATH=/webhook

DATABASE_PATH=data/logistics.db

